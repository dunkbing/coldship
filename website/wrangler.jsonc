// The docs are a static site: deploy dist/ as plain assets. Without this file,
// `wrangler deploy` auto-configures an SSR adapter and the build breaks.
{
  "name": "coldship",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
